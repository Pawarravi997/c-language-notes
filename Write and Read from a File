#include <stdio.h>

int main() {
    FILE *fptr;
    char str[100];

    // Writing to a file
    fptr = fopen("output.txt", "w");
    if(fptr == NULL) {
        printf("Error opening file");
        return 1;
    }

    printf("Enter a line: ");
    gets(str);
    fprintf(fptr, "%s", str);
    fclose(fptr);

    // Reading from the file
    fptr = fopen("output.txt", "r");
    if(fptr == NULL) {
        printf("Error reading file");
        return 1;
    }

    printf("\nContent from file:\n");
    while(fgets(str, sizeof(str), fptr))
        printf("%s", str);

    fclose(fptr);
    return 0;
}
