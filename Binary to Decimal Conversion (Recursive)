#include <stdio.h>
#include <math.h>

int binaryToDecimal(int n) {
    if (n == 0)
        return 0;
    return (n % 10) + 2 * binaryToDecimal(n / 10);
}

int main() {
    int bin;
    printf("Enter binary number: ");
    scanf("%d", &bin);
    printf("Decimal: %d", binaryToDecimal(bin));
    return 0;
}
